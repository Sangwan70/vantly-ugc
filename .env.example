# vantly-ugc — environment template (self-host)
# Copy to .env.local for local dev, or .env.prod for a real deployment, and
# fill in. All config is injected at RUNTIME — never commit either file.
# Names below match what the code actually reads (verified against source).
#
# NOTE: never put a comment after `=` on the same line. Docker Compose's
# `env_file` reader does not strip them, so `FOO=bar   # note` sets FOO to the
# literal string "bar   # note". Comments live on their own line, above the var.

# ── Compose environment selection ─────────────────────────────────────────
# docker-compose.yml reads env_file: ["${ENV_FILE:-.env.local}"], and ENV_FILE
# is resolved from whichever file you pass to --env-file. Keep this line equal
# to THIS file's own name so both stay in sync:
#   docker compose --env-file .env.local up      # local dev
#   docker compose --env-file .env.prod up -d    # production
ENV_FILE=.env.local

# ── Supabase (identity + data) — required ────────────────────────────────
# JWT_SECRET — signs/verifies every token this stack issues: user session
# JWTs (GoTrue) and the two static API keys below (SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY are themselves JWTs signed with this secret).
# Generate a real one per deployment — do NOT reuse the same value across
# environments, and do NOT use the demo default docker-compose.yml falls
# back to (it's published in this repo, so it's only safe for a stack
# nothing untrusted can reach). `openssl rand -hex 32` gives the secret
# itself; SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY then need to be
# HS256 JWTs signed with it (role: anon / role: service_role, iss:
# supabase) — ask your AI assistant to generate a matched set the same
# way this instance's were generated, rather than hand-rolling them.
JWT_SECRET=
# SUPABASE_URL — server-side base URL every backend service (api-v2, the
# workers, and the web app's own route handlers / middleware) uses to reach
# Supabase Auth + REST + Storage. docker-compose.yml already points this at
# the bundled `gateway` service for every container it runs (a small nginx
# in front of GoTrue/PostgREST/storage-api — see supabase/self-host-gateway/
# nginx.conf for why that indirection exists), so you normally do NOT need to
# set this by hand for the docker compose path. Only set it if you run a
# service outside docker-compose (e.g. api-v2 on bare metal) — point it at
# whatever exposes that same Auth+REST+Storage gateway for you.
SUPABASE_URL=
# server-side only; bypasses RLS — treat as root
SUPABASE_SERVICE_ROLE_KEY=
# JWT verification + OAuth proxy; absent = OAuth off
SUPABASE_ANON_KEY=
# browser-safe copies read at runtime by the web app. In docker-compose this
# is the gateway's PUBLISHED port (http://localhost:8000 by default) — the
# one address a browser on your own machine can actually reach.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_PUBLIC_URL — same value as NEXT_PUBLIC_SUPABASE_URL above (in
# docker-compose.yml these two are set from the same var so they can't drift).
# The web app's middleware needs this SEPARATELY from the NEXT_PUBLIC_ copy to
# allow it in the Content-Security-Policy connect-src — without it, every
# browser-side Supabase call (email OTP sign-in included) is silently blocked
# by the browser's own CSP before it becomes a network request, and fails
# with a bare "Failed to fetch". Leave unset only if you're deploying to
# Vercel against hosted Supabase (*.supabase.co), which is already allowed.
# Set this to your real public domain in production, e.g.
# https://app.vantly-ugc.com or wherever your gateway is reachable from.
SUPABASE_PUBLIC_URL=

# ── Providers ─────────────────────────────────────────────────────────────
# comma-separated pool (video: Seedance 2.0 mini)
EVOLINK_API_KEYS=
EVOLINK_MAX_CONCURRENT_PER_KEY=3
# gpt-image-2 + image moderation (absent = moderation off)
OPENAI_API_KEY=
# prompt craft (Haiku/Opus)
ANTHROPIC_API_KEY=

# Model provider for Anthropic/Claude text calls (script writing, prompt
# building, the in-app creative agent). 'anthropic' (default) calls
# api.anthropic.com directly. 'openrouter' routes the same Anthropic Messages
# API calls through OpenRouter's Anthropic-compatible endpoint instead —
# useful for OpenRouter's unified billing/rate-limits or to use a Claude
# model OpenRouter fronts. Set OPENROUTER_API_KEY when using 'openrouter'.
MODEL_PROVIDER=anthropic
OPENROUTER_API_KEY=
# Optional: pin every OpenRouter call to one specific model, overriding
# whatever model each call site would otherwise ask for (e.g. Opus for
# scripts, Haiku for prompt-building). Accepts either a bare Claude model
# id (gets "anthropic/" prefixed automatically) or a fully-qualified
# OpenRouter slug for ANY model OpenRouter hosts, Claude or not (e.g.
# "openai/gpt-4o", "google/gemini-2.5-pro"). Leave blank to let each call
# site's own default model through (still auto-prefixed if it's bare).
# Only read when MODEL_PROVIDER=openrouter.
OPENROUTER_MODEL=

# ── Object storage (S3-compatible) — required by workers ─────────────────
# Defaults target Cloudflare R2. Set S3_ENDPOINT to point anywhere else
# (MinIO, AWS S3, Backblaze B2) — docker-compose.yml does exactly that.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# NOTE: code reads R2_BUCKET (not R2_BUCKET_NAME)
R2_BUCKET=vantly-ugc
R2_PUBLIC_URL=
# Empty = derive https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# MinIO example: S3_ENDPOINT=http://minio:9000 with S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
# Empty = "auto" (correct for R2). AWS S3 needs a real region, e.g. us-east-1
S3_REGION=
# "true" for MinIO and most non-AWS gateways; empty = virtual-hosted style
S3_FORCE_PATH_STYLE=

# ── Temporal (vNext orchestration) — required for composed workflows ─────
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
TEMPORAL_TLS=true

# ── Billing mode ─────────────────────────────────────────────────────────
# FAIL-CLOSED: billing is ON unless you explicitly set BILLING_MODE=disabled.
# Self-hosters set `disabled` to skip the credit ledger entirely and pay their
# upstream providers directly.
#
# ⚠ Set this IDENTICALLY on api-v2 AND every worker. A split configuration is
# how media gets rendered without being charged.
BILLING_MODE=

# Stripe — only needed when BILLING_MODE is not 'disabled'.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Internal service auth (generate long random strings) ─────────────────
WORKER_SECRET=
INTERNAL_API_SECRET=
CRON_SECRET=
SUBTITLE_WORKER_SECRET=
VNEXT_PRIMITIVE_WORKER_SECRET=
BRAND_EXTRACTOR_SECRET=

# ── Feature flags ─────────────────────────────────────────────────────────
# off = the vNext skills surface is dark
VNEXT_PRIMITIVES_ENABLED=true
# curates the agent surface to make_ugc (+ podcast/subtitles)
MAKE_UGC_ENABLED=true
# set 1 to fail closed on moderation outages
IMAGE_MODERATION_FAILCLOSED=

# ── URLs ──────────────────────────────────────────────────────────────────
PUBLIC_API_ORIGIN=http://localhost:3001
# api-v2's own public-facing origin/base — used for its MCP OAuth
# issuer/resource metadata and for api-v2 calling itself (tool-registry,
# MCP tool execution). Must be a URL a real external client can reach this
# instance at — not an internal Docker hostname. Same value as
# PUBLIC_API_ORIGIN above; a couple of modules read this name instead.
PUBLIC_API_BASE=http://localhost:3001
PORT=3001

# ── Web app (read at RUNTIME by the root layout, not baked at build) ─────
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_MCP_URL=http://localhost:3001/mcp
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# ── Provider selection (see services/media-worker-v2/src/providers/) ─────
# Registered adapters: evolink (default), byteplus
VIDEO_PROVIDER=evolink
# Optional model pins
EVOLINK_SEEDANCE_MODEL=
BYTEPLUS_SEEDANCE_MODEL=
GPT_IMAGE_MODEL=
# Required only when VIDEO_PROVIDER=byteplus
ARK_API_KEY=

# ── Access control & support (fail-closed defaults) ──────────────────────
# Comma-separated admin emails. EMPTY by default: a fresh install grants
# admin to nobody until you opt someone in.
ADMIN_EMAILS=
NEXT_PUBLIC_ADMIN_EMAILS=
# Comma-separated emails exempt from the subscription wall (middleware.ts) -
# they get full app access without ever hitting /subscribe or
# /onboarding/plan. Does NOT grant admin or credits on its own. EMPTY by
# default, same fail-closed reasoning as ADMIN_EMAILS above.
EXEMPTED_EMAILS=
# Support form: empty disables it.
SUPPORT_INBOX=
SUPPORT_FROM=
RESEND_API_KEY=

# ── Optional browser-facing config ───────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_DISCORD_INVITE_URL=

# Host port for the dashboard (container always listens on 3000). Default
# bumped to 3005 since 3000 is the most contested port on any dev machine.
WEB_PORT=3005

# ── Other overridable host ports (containers keep their normal ports;
# these only change what's published on your machine) ────────────────────
# Adjust any of these if they collide with another local stack.
POSTGRES_PORT=5433
TEMPORAL_PORT=7234
MEDIA_WORKER_PORT=3010
BRAND_EXTRACTOR_PORT=3012

# APP_PUBLIC_URL — this deployment's own public URL (no trailing slash).
# Used as the base for: GoTrue auth redirect links (docker-compose.yml),
# the Postiz/Vantly OAuth callback's registered redirect URL (below), and the
# social-connect redirect target (services/api-v2/src/routes/v1/social.ts).
# Set this to your real domain in production; local dev can leave it unset
# (falls back to http://localhost:${WEB_PORT:-3005}).
APP_PUBLIC_URL=

# SUPPORT_EMAIL — shown on the Terms/Privacy pages as a contact address for
# this instance. Optional; those pages render without it if left unset.
SUPPORT_EMAIL=

# ── Postiz-based social publishing (self-hosted "Vantly" instance) ───────
# Two ways a user connects, both landing on the SAME profiles.postiz_api_key
# column and the SAME /public/v1 API underneath (see /integrations/postiz):
#   1. Manual: paste your own org API key from vantly.social/settings.
#   2. OAuth (default, "Connect with Vantly" button): requires the vars below.
#
# VANTLY_API_BASE_URL — the authenticated per-org API both paths call.
# Only change this if Vantly moves or you're pointing at a different
# Postiz-compatible instance for local testing. Read by services/api-v2 AND
# by the supabase/functions/webhook-provider edge function (which fans out
# Postiz publishing when a generation job completes) — for the edge function
# this must also be set as a Supabase secret:
#   supabase secrets set VANTLY_API_BASE_URL=https://vantly.social/api/public/v1
VANTLY_API_BASE_URL=https://vantly.social/api/public/v1

# VANTLY_APP_URL — Vantly's own base origin. Used for: the unauthenticated
# provider catalog (GET {VANTLY_APP_URL}/api/integrations), the browser-facing
# OAuth consent screen ({VANTLY_APP_URL}/oauth/authorize), and the token
# endpoint ({VANTLY_APP_URL}/api/oauth/token).
VANTLY_APP_URL=https://vantly.social

# VANTLY_CLIENT_ID / VANTLY_CLIENT_SECRET — from registering vantly-ugc-app
# as an OAuth App on Vantly (an org admin does this once at
# vantly.social -> Settings -> OAuth App), with the redirect URL set to
# {APP_PUBLIC_URL}/api/integrations/postiz/oauth/callback. Required for the
# "Connect with Vantly" button; the manual API-key field still works without
# these set.
VANTLY_CLIENT_ID=
VANTLY_CLIENT_SECRET=

# VANTLY_SSO_KEY — a SEPARATE shared secret from VANTLY_CLIENT_ID/SECRET.
# Only needed if you wire up Vantly's bespoke GET /vantly-ugc-sso endpoint
# (vantly/apps/backend/src/api/routes/users.controller.ts) — e.g. a "launch
# vantly-ugc-app" link on vantly.social itself. Set the exact same value as
# VANTLY_UGC_SSO_KEY in vantly's own backend environment. Not required for
# the "Sign in with Vantly" button on vantly-ugc-app's own /login page,
# which uses VANTLY_CLIENT_ID/SECRET instead — see apps/web/app/sso/[token]/route.ts
# vs apps/web/app/api/auth/vantly/route.ts for the difference.
VANTLY_SSO_KEY=

# ── Email (Postmark SMTP) — powers GoTrue's OTP sign-in emails ───────────
# Without these, GoTrue has no way to send the OTP email and sign-in
# requests will silently fail to deliver. Get the Server Token from your
# Postmark server's "API Tokens" tab — it doubles as both the SMTP
# username and password. GOTRUE_SMTP_ADMIN_EMAIL must be a Postmark-
# verified Sender Signature or verified sending domain.
GOTRUE_SMTP_HOST=smtp.postmarkapp.com
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_SENDER_NAME=Vantly UGC
GOTRUE_SMTP_ADMIN_EMAIL=

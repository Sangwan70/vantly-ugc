{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Sangwan70/vantly-ugc-app",
  "description": "Generate AI UGC videos with talking heads, B-roll, and subtitles.",
  "repository": {
    "url": "https://github.com/Sangwan70/vantly-ugc",
    "source": "github",
    "subfolder": "packages/mcp-server"
  },
  "version": "0.7.9",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "vantly-ugc-mcp-server",
      "version": "0.7.9",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "API key (ma_xxx format) from vantly-ugc.com",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "VANTLY_UGC_API_KEY"
        }
      ]
    }
  ]
}

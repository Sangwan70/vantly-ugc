{
  "name": "vantly-ugc-mcp-server",
  "version": "0.7.9",
  "mcpName": "io.github.gitroomhq/vantly-ugc-app",
  "description": "MCP server for vantly-ugc — generate AI UGC videos from Claude Code, Cursor, Windsurf, or any MCP-compatible client.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://vantly-ugc.com/integrations",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sangwan70/vantly-ugc.git",
    "directory": "packages/mcp-server"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "windsurf",
    "ugc",
    "video-generation",
    "ai",
    "developer-tools",
    "ai-agent",
    "product-video",
    "product-ugc",
    "talking-head",
    "text-to-video",
    "vantly-ugc"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "bin": {
    "mcp-server": "dist/index.js",
    "vantly-ugc-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --external:@modelcontextprotocol/sdk --external:zod --external:zod-to-json-schema --banner:js=\"import { createRequire as __cr } from 'module'; const require = __cr(import.meta.url);\" && chmod +x dist/index.js",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "esbuild": "^0.24.2"
  }
}
